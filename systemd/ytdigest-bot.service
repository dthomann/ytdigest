[Unit]
Description=ytdigest Telegram Q&A bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ytdigest
WorkingDirectory=/opt/ytdigest
EnvironmentFile=/opt/ytdigest/.env
ExecStart=/opt/ytdigest/venv/bin/ytdigest --config /opt/ytdigest/config.yaml bot
Restart=always
RestartSec=30
MemoryMax=200M

[Install]
WantedBy=multi-user.target
