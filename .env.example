# Copy to .env and fill in. chmod 600 .env. Never commit this file.

# Deploy from dev machine (optional — used by scripts/deploy.sh)
YTDIGEST_PI=

YOUTUBE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# YouTube OAuth — TVs and Limited Input devices client (see README: Connect YouTube account)
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# Web UI — required when web_host is not loopback (recommended for any LAN exposure)
WEB_AUTH_TOKEN=

# ProxyScrape residential — optional; on tier1 429, retry captions up to 3 times via this proxy
# Copy username/password from https://dashboard.proxyscrape.com/v2/services/residential/proxy-setup/
PROXYSCRAPE_USERNAME=
PROXYSCRAPE_PASSWORD=
# PROXYSCRAPE_HOST=rp.scrapegw.com
# PROXYSCRAPE_PORT=6060
# PROXYSCRAPE_COUNTRY=ch
